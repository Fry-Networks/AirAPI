{
  "compilerOptions": {
    "experimentalDecorators": true,
    "target": "es2016",
    "module": "NodeNext",
    "rootDir": "./src",
    "baseUrl": "./src",
    "outDir": "./build",
    "lib": [
      "es2016",
    ],
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "noEmit": false
  },
  "include": [
    "src/main.ts",
    "src/api/api.ts",
    "src/api/routes/*.ts",
    "src/db/**/*"
  ],
  "exclude": [
    "src/services/**/*",
    "src/devices/**/*",
    "src/types/**/*",
    "src/test.ts",
    "src/api/routes/getDeviceCredentialRoute.ts"
  ]
}
